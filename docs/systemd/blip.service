[Unit]
Description=Blip self-hosted webhook deploy server
After=network.target

[Service]
ExecStart=/usr/local/bin/blip --config /etc/blip/blip.toml serve
Restart=on-failure
User=blip
Group=blip
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/blip

[Install]
WantedBy=multi-user.target
